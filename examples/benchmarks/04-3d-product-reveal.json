{
  "$schema": "https://motionstudio.ai/schemas/scene-v1.json",
  "id": "bm-04-3d-product-reveal",
  "version": "1.0.0",
  "meta": {
    "title": "3D Product Slate Reveal",
    "description": "Floating extruded physical product card with studio lighting and orbital camera.",
    "seed": 5511
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration": 3.0,
    "aspectRatio": "16:9"
  },
  "brand": {
    "preset": "modern-saas"
  },
  "components": [
    {
      "type": "LightingRig",
      "id": "rig-studio",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "orbitLights": true
      }
    },
    {
      "type": "OrbitalCamera",
      "id": "cam-tracking",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "orbitSpeed": 0.25,
        "orbitRadiusX": 3.5,
        "initialZ": 4.8,
        "targetY": 0.5
      }
    },
    {
      "type": "PodiumStage",
      "id": "base-podium",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "yPosition": -1.3,
        "stageColor": 922143,
        "ringColor": 3718648
      }
    },
    {
      "type": "ProductCard",
      "id": "hero-card",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "width": 3.6,
        "height": 2.2,
        "borderColor": 3718648
      }
    },
    {
      "type": "BrandBadge",
      "id": "product-badge",
      "layer": "2d-dom",
      "timing": { "start": 0.2, "duration": 0.8 },
      "parameters": {
        "text": "Motion Studio Pro"
      }
    }
  ]
}
