{
  "$schema": "https://motionstudio.ai/schemas/scene-v1.json",
  "id": "bm-05-3d-abstract-visual",
  "version": "1.0.0",
  "meta": {
    "title": "3D Abstract Particle Cloud",
    "description": "Atmospheric particle field with floating glass surfaces and procedural core.",
    "seed": 8812
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration": 3.0,
    "aspectRatio": "16:9"
  },
  "brand": {
    "preset": "modern-saas"
  },
  "components": [
    {
      "type": "LightingRig",
      "id": "lights-abstract",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "fillColor": 439999,
        "rimColor": 6514417
      }
    },
    {
      "type": "OrbitalCamera",
      "id": "cam-abstract",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "orbitSpeed": 0.4,
        "orbitRadiusX": 4.5,
        "initialZ": 5.5
      }
    },
    {
      "type": "ParticleField",
      "id": "hero-particles",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "count": 220,
        "size": 0.06,
        "driftSpeed": 0.2,
        "seed": 8812
      }
    },
    {
      "type": "ProceduralArtifact",
      "id": "abstract-core",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "outerShape": "octahedron",
        "transmission": 0.85
      }
    },
    {
      "type": "GlassSurface",
      "id": "backdrop-plane",
      "layer": "3d-webgl",
      "timing": { "start": 0.0, "duration": 3.0 },
      "parameters": {
        "width": 7.0,
        "height": 4.0,
        "opacity": 0.7
      }
    }
  ]
}
