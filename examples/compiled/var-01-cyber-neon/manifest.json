        "text": "CYBER EDGE",
        "accentColor": "#00f0ff"
      }
    },
    {
      "type": "TextReveal",
      "id": "headline",
      "layer": "2d-dom",
      "timing": {
        "start": 0.3,
        "duration": 1.2
      },
      "parameters": {
        "text": "High Velocity Real-Time Computing",
        "variant": "hero",
        "gradient": true
      },
      "motion": {
        "intensity": "energetic",
        "ease": "expo.out"
      }
    }
  ]
}