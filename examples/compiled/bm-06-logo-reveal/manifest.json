{
  "$schema": "https://motionstudio.ai/schemas/scene-v1.json",
  "id": "bm-06-logo-reveal",
  "version": "1.0.0",
  "meta": {
    "title": "Dynamic Logo Sting",
    "description": "Geometric vector brand mark trace with kinetic subtitle entrance.",
    "seed": 2048
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration": 3,
    "aspectRatio": "16:9"
  },
  "brand": {
    "preset": "modern-saas"
  },
  "components": [
    {
      "type": "ShapeReveal",
      "id": "accent-brackets",
      "layer": "2d-dom",
      "timing": {
        "start": 0,
        "duration": 1
      },
      "parameters": {
        "color": "#06b6d4"
      }
    },
    {
      "type": "LogoReveal",
      "id": "hero-logo",
      "layer": "2d-dom",
      "timing": {
        "start": 0.2,
        "duration": 1.4
      },
      "parameters": {
        "size": 84,
        "color": "#38bdf8"
      }
    },
    {
      "type": "TextReveal",
      "id": "brand-name",
      "layer": "2d-dom",
      "timing": {
        "start": 0.9,
        "duration": 1
      },
      "parameters": {
        "text": "MOTION STUDIO",
        "variant": "headline",
        "gradient": true
      }
    }
  ]
}