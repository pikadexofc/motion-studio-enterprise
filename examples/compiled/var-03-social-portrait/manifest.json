{
  "$schema": "https://motionstudio.ai/schemas/scene-v1.json",
  "id": "var-03-social-portrait",
  "version": "1.0.0",
  "meta": {
    "title": "Variant 3: 9:16 Social Portrait",
    "seed": 1003
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 60,
    "duration": 3,
    "aspectRatio": "9:16"
  },
  "brand": {
    "preset": "modern-saas"
  },
  "components": [
    {
      "type": "LightingRig",
      "id": "lights",
      "layer": "3d-webgl",
      "timing": {
        "start": 0,
        "duration": 3
      },
      "parameters": {
        "fillColor": 439999,
        "rimColor": 6514417
      }
    },
    {
      "type": "OrbitalCamera",
      "id": "cam",
      "layer": "3d-webgl",
      "timing": {
        "start": 0,
        "duration": 3
      },
      "parameters": {
        "orbitRadiusX": 2.2,
        "initialZ": 5.8,
        "targetY": 0.1,
        "fov": 55
      }
    },
    {
      "type": "ProceduralArtifact",
      "id": "artifact",
      "layer": "3d-webgl",
      "timing": {
        "start": 0,
        "duration": 3
      },
      "parameters": {
        "outerRadius": 1.1,
        "innerRadius": 0.55
      }
    },
    {
      "type": "BrandBadge",
      "id": "badge",
      "layer": "2d-dom",
      "timing": {
        "start": 0.1,
        "duration": 0.8
      },
      "parameters": {
        "text": "MOBILE FIRST",
        "accentColor": "#38bdf8"
      }
    },
    {
      "type": "TextReveal",
      "id": "headline",
      "layer": "2d-dom",
      "timing": {
        "start": 0.3,
        "duration": 1.2
      },
      "parameters": {
        "text": "Engineered For Mobile Feeds",
        "variant": "headline",
        "gradient": true
      }
    }
  ]
}